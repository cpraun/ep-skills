.DS_Store

# Python bytecode caches and test/venv artifacts (from the test harness)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local secrets for the test harness — holds the Gemini API key, never commit
test/env.sh

# Old location of the user's Word template (now ~/.ep-skills/template.docx); kept as a safeguard
skills/util/handle-docx/assets/template.docx

# Old location of learned rules (now ~/.ep-skills/learned/); they may contain case details
skills/**/LEARNED.md

# Local citation test cases with real case material (see test/verify-citations/cases/README.md)
test/verify-citations/cases/local-*/
